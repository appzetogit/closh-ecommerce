{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "frontend",
      "runtimeExecutable": "powershell",
      "runtimeArgs": ["-NoProfile", "-Command", "$env:VITE_API_BASE_URL='http://localhost:5050/api'; npm run dev --prefix frontend -- --port 5180 --strictPort"],
      "port": 5180
    },
    {
      "name": "backend",
      "runtimeExecutable": "powershell",
      "runtimeArgs": ["-NoProfile", "-Command", "$env:PORT='5050'; $env:CLIENT_URL='http://localhost:5180'; npm run dev --prefix backend"],
      "port": 5050
    }
  ]
}
